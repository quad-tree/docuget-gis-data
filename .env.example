# Copy to .env (in the repo root) and adjust.
# Used by scripts/lib.sh — falls back to docuget-devops/docker/gis/.env if absent
# (so Docuget contributors get zero-config when the devops container is up).

# Loader container — name + network in the docker-compose stack.
GIS_DB_CONTAINER=docuget-gis-db
GIS_DB_NETWORK=gis_default
GIS_DB_HOST_IN_NETWORK=docuget-gis-db

# Inside-container connection params.
GIS_DB_NAME=docuget_gis
GIS_DB_USER=docuget
GIS_DB_PASSWORD=changeme

# Tooling images.
GDAL_IMAGE=ghcr.io/osgeo/gdal:alpine-small-latest
POSTGIS_IMAGE=postgis/postgis:18-3.6-alpine
